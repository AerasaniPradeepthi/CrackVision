# =================================================================
# CrackVision — Structural Crack Detection and Monitoring System
# Environment Configuration Template
# Copy this file to .env and populate with your credentials.
# =================================================================

# -----------------------------------------------------------------
# 1. Cloud MySQL Database Configuration (e.g. Aiven Cloud MySQL)
# -----------------------------------------------------------------
CRACKVISION_DB_HOST=mysql-crackvision-example.aivencloud.com
CRACKVISION_DB_PORT=14777
CRACKVISION_DB_NAME=defaultdb
CRACKVISION_DB_USER=avnadmin
CRACKVISION_DB_PASSWORD=your_secure_db_password_here

# Optional: Full custom JDBC Connection URL (takes precedence if provided)
# CRACKVISION_DB_URL=jdbc:mysql://mysql-crackvision-example.aivencloud.com:14777/defaultdb?ssl-mode=REQUIRED

# -----------------------------------------------------------------
# 2. AI Computer Vision Microservice Configuration
# -----------------------------------------------------------------
CRACKVISION_AI_SERVICE_URL=http://localhost:8000
CRACKVISION_AI_CONNECT_TIMEOUT_MS=5000
CRACKVISION_AI_READ_TIMEOUT_MS=30000

# -----------------------------------------------------------------
# 3. Security & Application Ports
# -----------------------------------------------------------------
PORT=3000
BACKEND_PORT=5050
AI_PORT=8000
